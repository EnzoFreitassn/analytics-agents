# PostgreSQL (Docker) connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/analytics?schema=public"

# Optional: host port for the Postgres container (default 5432).
# Set this (and the port in DATABASE_URL) if 5432 is already in use.
# POSTGRES_PORT=5432

# LLM via Groq (SDK da OpenAI apontado para a Groq)
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY="sua_chave_groq"
LLM_MODEL="openai/gpt-oss-120b"

# Modo de montagem do prompt:
#   false (padrão) -> baseline: schema inteiro no prompt (config preciso, 27/3/0)
#   true           -> RAG: recupera só os chunks relevantes (experimental; exige
#                     baixar o modelo de embedding local @xenova/transformers)
USE_RAG="false"
